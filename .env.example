PORT=4000

# --- Dashboard login (JWT) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# --- Google Sheets logging ---
GOOGLE_SHEET_ID=your_google_sheet_id
# Full service-account key JSON as a single-line value — required on a deployed server,
# since the file-based alternative (src/config/google-service-account.json) is git-ignored.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}
GOOGLE_SHEETS_LOG_TAB=Log
GOOGLE_SHEETS_FLAGGED_TAB=Flagged
GOOGLE_SHEETS_VARIATION_TAB=Price Variation

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=price_tracker

# No in-process cron — scheduling is external (see README §7). Checked against the
# X-Cron-Secret header on POST /api/cron/price-check and /api/cron/auto-reply.
CRON_SECRET=change-me-to-a-random-string

# Comma-separated site names this server should NOT scrape directly (they get blocked
# by cloud/data-center IPs) — a local worker reports these instead. See README §5.
PRICE_CHECK_SKIP_SITES=meesho
# Shared secret the local worker must send in the X-Worker-Secret header
LOCAL_WORKER_SECRET=change-me-to-a-random-string

# --- Bypassing site blocks (optional — pick one, or neither) ---
# Option A: ScraperAPI (or similar "unlocker" service) — free tier covers some sites,
# heavily-protected ones (Snapdeal/Nykaa/Tira/Meesho) need a paid premium-proxy plan.
SCRAPERAPI_KEY=your_scraperapi_key
# Option B: a residential proxy service (e.g. IPRoyal) instead
PROXY_SERVER=http://geo.iproyal.com:12321
PROXY_USERNAME=your_proxy_username
PROXY_PASSWORD=your_proxy_password

TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# --- auto-reply (Hermes AI via OpenRouter) ---
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=nousresearch/hermes-3-llama-3.1-405b

# WordPress (create under WP Admin -> Users -> Application Passwords)
WP_USERNAME=your_wp_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Shopify reviews via Judge.me
JUDGEME_API_TOKEN=your_judgeme_api_token
JUDGEME_SHOP_DOMAIN=your-store.myshopify.com

# --- WordPress Contact Form 7 -> AI email reply ---
# Shared secret the WordPress PHP snippet must send in the X-Form-Secret header
CF7_WEBHOOK_SECRET=change-me-to-a-random-string

SMTP_FROM_NAME=Your Store Support

# --- Resend (reply emails, sent over HTTPS — many hosts block outbound SMTP) ---
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=onboarding@resend.dev
# Per-platform sender once each domain is verified in the Resend dashboard:
RESEND_FROM_SHOPIFY=support@your-shopify-store-domain.com
RESEND_FROM_WOOCOMMERCE=support@your-woocommerce-store-domain.com

# --- WooCommerce Admin API (exact stock quantity) ---
WC_CONSUMER_KEY=your_woocommerce_consumer_key
WC_CONSUMER_SECRET=your_woocommerce_consumer_secret

# --- Shopify Admin API (exact stock quantity) ---
SHOPIFY_ADMIN_TOKEN=your_shopify_admin_api_token
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com

# --- Flipkart Seller API (exact stock quantity) ---
FLIPKART_CLIENT_ID=your_flipkart_client_id
FLIPKART_CLIENT_SECRET=your_flipkart_client_secret

# --- Added later; documented in README.md ---

# Role given to ADMIN_USERNAME by `npm run seed:admin`. "admin" shows in the UI as
# "E-commerce Executive".
ADMIN_ROLE=admin

# A second seeded account with full access, including user management.
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

# Enables "Sign in with Google". Must match VITE_GOOGLE_CLIENT_ID in the frontend, and the
# frontend's origin must be an authorised JavaScript origin for this client ID.
GOOGLE_CLIENT_ID=

# Tab holding the append-only feed of every price and stock change.
GOOGLE_SHEETS_CHANGES_TAB=Price & Stock Changes

# Optional. If the local worker exposes an HTTP endpoint (e.g. through a tunnel), the
# server can ask it to fetch a page on demand instead of waiting for the worker's schedule.
WORKER_HTTP_URL=

# Shopify app client secret, only needed for webhook signature checks.
SHOPIFY_CLIENT_SECRET=
